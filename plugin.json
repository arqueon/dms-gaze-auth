{
  "$schema": "https://github.com/AvengeMedia/DankMaterialShell/raw/refs/heads/master/quickshell/PLUGINS/plugin-schema.json",
  "id": "gazeAuth",
  "name": "Gaze Authentication",
  "description": "Inspect Gaze face-authentication health and DMS lock integration without changing PAM or biometric data.",
  "version": "0.3.0",
  "license": "GPL-3.0-or-later",
  "author": "arqueon",
  "repo": "https://github.com/arqueon/dms-gaze-auth",
  "type": "widget",
  "component": "./GazeAuth.qml",
  "settings": "./Settings.qml",
  "icon": "face",
  "category": "utilities",
  "capabilities": [
    "control-center",
    "authentication",
    "command-execution"
  ],
  "compositors": [
    "any"
  ],
  "distro": [
    "any"
  ],
  "dependencies": [
    "bash",
    "gaze",
    "systemctl",
    "xdg-open"
  ],
  "permissions": [
    "process",
    "settings_read",
    "settings_write"
  ],
  "requires_dms": ">=1.5.0"
}
