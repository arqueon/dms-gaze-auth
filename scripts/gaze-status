#!/usr/bin/env bash
set -uo pipefail

mode="${1:-status}"
pam_dir="${GAZE_AUTH_PAM_DIR:-/etc/pam.d}"
settings_file="${GAZE_AUTH_DMS_SETTINGS:-${XDG_CONFIG_HOME:-$HOME/.config}/DankMaterialShell/settings.json}"
os_release="${GAZE_AUTH_OS_RELEASE:-/etc/os-release}"

flatten() {
    tr '\n\t' '  ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//; s/=/≠/g'
}

has_gaze_in() {
    local target="$1"
    [ -r "$target" ] && grep -Eq '^[[:space:]]*auth[[:space:]].*pam_gaze(_grosshack)?\.so([[:space:]]|$)' "$target"
}

emit_bool() {
    local key="$1"
    shift
    if "$@" >/dev/null 2>&1; then
        printf '%s=1\n' "$key"
    else
        printf '%s=0\n' "$key"
    fi
}

read_os_release() {
    distro_id="unknown"
    distro_name="Unknown Linux"
    if [ -r "$os_release" ]; then
        distro_id="$(sed -n 's/^ID=//p' "$os_release" | head -n 1 | tr -d '"' | flatten)"
        distro_name="$(sed -n 's/^PRETTY_NAME=//p' "$os_release" | head -n 1 | sed 's/^"//; s/"$//' | flatten)"
    fi
    printf 'distro_id=%s\n' "${distro_id:-unknown}"
    printf 'distro_name=%s\n' "${distro_name:-Unknown Linux}"
}

status() {
    read_os_release

    if command -v gaze >/dev/null 2>&1; then
        printf 'installed=1\n'
        printf 'version=%s\n' "$(gaze --version 2>/dev/null | flatten)"
    else
        printf 'installed=0\nversion=Not installed\n'
    fi

    emit_bool gui_available command -v gaze-gui
    emit_bool config_present test -r /etc/gaze/config.toml

    if command -v systemctl >/dev/null 2>&1; then
        emit_bool daemon_active systemctl is-active --quiet gazed
        emit_bool daemon_enabled systemctl is-enabled --quiet gazed
    else
        printf 'daemon_active=0\ndaemon_enabled=0\n'
    fi

    # Enrollment is intentionally checked only by the explicit doctor action.
    # Some Gaze versions emit terminal control sequences from `list-faces` when
    # stdout is captured by Quickshell, and querying it on every CC open adds
    # latency without improving daemon health detection.
    printf 'enrolled=unknown\nface_summary=Run doctor to verify\n'

    emit_bool pam_lock has_gaze_in "$pam_dir/dankshell-gaze"
    emit_bool pam_sudo has_gaze_in "$pam_dir/sudo"
    emit_bool pam_polkit has_gaze_in "$pam_dir/polkit-1"
    emit_bool pam_greetd has_gaze_in "$pam_dir/greetd"

    if [ -r "$settings_file" ] && grep -Eq '"lockPamPath"[[:space:]]*:[[:space:]]*"/etc/pam.d/dankshell-gaze"' "$settings_file"; then
        printf 'dms_path_selected=1\n'
    else
        printf 'dms_path_selected=0\n'
    fi
}

doctor() {
    if ! command -v gaze >/dev/null 2>&1; then
        printf '%s\n' 'Gaze is not installed. Open the official installation guide first.'
        return 127
    fi
    gaze doctor 2>&1
}

case "$mode" in
    status) status ;;
    doctor) doctor ;;
    *)
        printf 'Usage: %s {status|doctor}\n' "$0" >&2
        exit 2
        ;;
esac
